{
  "name": "s3-flash-drive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node server/main.js",
    "test": "node --test test/*.test.js",
    "lint": "node tooling/check-architecture.mjs",
    "format": "prettier --write \"src/**/*.{js,jsx,css,json}\" \"server/**/*.js\" \"shared/*.js\" \"tooling/*.mjs\" \"test/**/*.js\" \"vite.config.js\" \"*.md\" \"deploy/*.md\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css,json}\" \"server/**/*.js\" \"shared/*.js\" \"tooling/*.mjs\" \"test/**/*.js\" \"vite.config.js\" \"*.md\" \"deploy/*.md\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/manrope": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "archiver": "^8.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "highlight.js": "^11.12.0",
    "ignore": "^7.0.14",
    "lucide-react": "^1.73.0",
    "mime-types": "^3.0.2",
    "parse-srcset": "^1.0.2",
    "parse5": "^8.1.1",
    "postcss-value-parser": "^4.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.2",
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fflate": "^0.8.2",
    "postcss": "^8.5.33",
    "postcss-custom-media": "^12.0.3",
    "prettier": "^3.10.1",
    "supertest": "^7.0.0",
    "vite": "^6.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
